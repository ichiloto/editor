# Static analysis for the editor.
#
# The Editor consumes Engine contracts directly through its Composer runtime
# dependency.
parameters:
    # Level 3 is free here and catches more than names that do not resolve:
    # an undefined property (`$category->title` for `label`) is a level 2
    # rule, and this codebase was already clean of them.
    level: 3
    paths:
        - src
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        - '#Ichiloto\\Editor\\(Animation|AnimationCue|AnimationPlayer)#'
